{
  "name": "het-devtools",
  "displayName": "HeT DevTools",
  "description": "C/C++ 工程面板（面向 fcpp 模板库）：构建、测试、依赖、文档、质量门禁、发布与上板基准一键可视化。A plain-language engineering cockpit for fcpp-based C/C++ libraries.",
  "version": "0.1.0",
  "publisher": "het-fti",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HeT-FTI/het-devtools.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "cpp",
    "c",
    "conan",
    "cmake",
    "fcpp",
    "het",
    "library",
    "build",
    "test",
    "documentation",
    "benchmark"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1f24",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:**/metadata.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "HeT DevTools",
      "properties": {
        "het.conan.profiles": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra Conan -pr profile files appended to every build (maintainer/dev-machine adaptations; not shipped defaults)."
        }
      }
    },
    "commands": [
      {
        "command": "het.hello",
        "title": "HeT DevTools: Hello (smoke test)"
      },
      {
        "command": "het.refresh",
        "title": "HeT DevTools: 重新检测项目"
      },
      {
        "command": "het.build",
        "title": "HeT DevTools: 构建项目"
      },
      {
        "command": "het.welcome",
        "title": "HeT DevTools: 入门向导"
      },
      {
        "command": "het.dashboard",
        "title": "HeT DevTools: 打开驾驶舱"
      },
      {
        "command": "het.healthCheck",
        "title": "HeT DevTools: 项目体检（驾驶舱）"
      },
      {
        "command": "het.test",
        "title": "HeT DevTools: 构建并测试"
      },
      {
        "command": "het.showTestResults",
        "title": "HeT DevTools: 查看测试结果"
      },
      {
        "command": "het.openSettings",
        "title": "HeT DevTools: 项目设置（metadata.json）"
      },
      {
        "command": "het.openDeps",
        "title": "HeT DevTools: 依赖管理器"
      },
      {
        "command": "het.addDependency",
        "title": "HeT DevTools: 添加依赖"
      },
      {
        "command": "het.newModule",
        "title": "HeT DevTools: 新增模块"
      },
      {
        "command": "het.generateTests",
        "title": "HeT DevTools: 生成测试（模式 A）"
      },
      {
        "command": "het.refreshTests",
        "title": "HeT DevTools: 刷新测试浏览器"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "compile:tests": "node esbuild.mjs --tests",
    "compile:integration": "node esbuild.mjs --integration",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run compile && npm run compile:tests && mocha \"out/test/**/*.test.js\"",
    "test:integration": "npm run compile && npm run compile:integration && node scripts/run-integration.mjs",
    "test:c1": "npm run compile && node esbuild.mjs --c1 && node scripts/run-c1.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "mocha": "^10.8.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
